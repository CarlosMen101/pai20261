<Window x:Class="ExamenUnidad1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExamenUnidad1"
        mc:Ignorable="d"
        Title="Cine-Max - Cajamarca" Height="600" Width="800" MinWidth="700" MinHeight="500">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,15">
            <Label Content="Cine-Max" FontSize="26" FontWeight="Bold" Foreground="#1F4E79" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <Label Content="Fecha actual:" FontSize="14" VerticalAlignment="Center"/>
                <TextBox x:Name="tbxFechaActual" Width="110" IsReadOnly="True" Background="#E0E0E0" FontSize="14" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <Label Content="Apellidos:"/>
                <TextBox x:Name="tbxApellidos" FontSize="14" Margin="0,0,0,5"/>
                <Label Content="Nombres:"/>
                <TextBox x:Name="tbxNombres" FontSize="14" Margin="0,0,0,10"/>
                <Button x:Name="btnRegistrar" Content="REGISTRAR BOLETO" Height="35" Background="#1F4E79" Foreground="White" FontWeight="Bold" Click="BtnRegistrar_Click"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <Label Content="Formato de Película:"/>
                <StackPanel Orientation="Horizontal" Margin="5,5,0,15">
                    <RadioButton x:Name="rb2D" Content="2D" IsChecked="True" FontSize="14" Margin="0,0,20,0"/>
                    <RadioButton x:Name="rb3D" Content="3D" FontSize="14"/>
                </StackPanel>
                <Label Content="Categoría del Espectador:"/>
                <ComboBox x:Name="cbCategoria" SelectedIndex="0" FontSize="14">
                    <ComboBoxItem Content="General"/>
                    <ComboBoxItem Content="Estudiante"/>
                    <ComboBoxItem Content="Adulto Mayor"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <DataGrid x:Name="lvRegistro" Grid.Row="2" Margin="0,0,0,15" AutoGenerateColumns="False" 
                  IsReadOnly="True" Background="White" RowHeaderWidth="0" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="1.5*"/>
                <DataGridTextColumn Header="Apellidos y Nombres" Binding="{Binding NombreCompleto}" Width="3.5*"/>
                <DataGridTextColumn Header="Formato" Binding="{Binding Formato}" Width="1.2*"/>
                <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="2*"/>
                <DataGridTextColumn Header="Precio Base" Binding="{Binding Precio, StringFormat='S/{0:F2}'}" Width="1.5*"/>
            </DataGrid.Columns>
        </DataGrid>

        <UniformGrid Grid.Row="3" Columns="5" Height="50">
            <Border Background="#E2EFDA" BorderBrush="#A9D08E" BorderThickness="1" Margin="2" Padding="5">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Total General" FontSize="11" Foreground="#375623" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="lblGeneral" Text="0" FontSize="14" FontWeight="Bold" Foreground="#375623" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Background="#E2EFDA" BorderBrush="#A9D08E" BorderThickness="1" Margin="2" Padding="5">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Estudiantes" FontSize="11" Foreground="#375623" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="lblEstudiantes" Text="0" FontSize="14" FontWeight="Bold" Foreground="#375623" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Background="#E2EFDA" BorderBrush="#A9D08E" BorderThickness="1" Margin="2" Padding="5">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Adulto Mayor" FontSize="11" Foreground="#375623" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="lblAdultoMayor" Text="0" FontSize="14" FontWeight="Bold" Foreground="#375623" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Background="#FFF2CC" BorderBrush="#F4B084" BorderThickness="1" Margin="2" Padding="5">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Total 2D" FontSize="11" Foreground="#C65911" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="lblAcumulado2D" Text="S/0.00" FontSize="14" FontWeight="Bold" Foreground="#C65911" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Background="#FFF2CC" BorderBrush="#F4B084" BorderThickness="1" Margin="2" Padding="5">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Total 3D" FontSize="11" Foreground="#C65911" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="lblAcumulado3D" Text="S/0.00" FontSize="14" FontWeight="Bold" Foreground="#C65911" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </UniformGrid>
    </Grid>
</Window>