<Window x:Class="OrdenarCadena.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OrdenarCadena" Height="450" Width="650">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="txtCadena" Grid.Row="0" Height="70" TextWrapping="Wrap" Margin="0,0,0,15" Padding="5"
                 Text="Liliana Angelina Leticia Amanda Patricia Roxana Luana Laura Kiara Kimberly Synthia Cintia Cecilia Ana Lina Thalia Teresa Pierina" TextChanged="txtCadena_TextChanged" />

        <Button x:Name="btnListar" Grid.Row="1" Content="&lt;&lt;Listar&gt;&gt;" Width="100" HorizontalAlignment="Left" Margin="20,15,0,15" Padding="2" FontWeight="Bold"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="lstTodos" Grid.Column="0" Margin="20,5,10,5"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Label Content="Letra" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBox x:Name="txtLetra" Width="40" TextAlignment="Center" Margin="0,5,0,15" MaxLength="1"/>
                <Button x:Name="btnPasar" Content="&lt;&lt;Pasar&gt;&gt;" Width="90" FontWeight="Bold" Padding="2"/>
            </StackPanel>

            <ListBox x:Name="lstFiltrados" Grid.Column="2" Margin="10,5,20,5"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="txtConteoTodos" Grid.Column="0" Width="40" HorizontalAlignment="Left" Margin="20,0,0,0" IsReadOnly="True" TextAlignment="Center"/>
            <TextBox x:Name="txtConteoFiltrados" Grid.Column="2" Width="40" HorizontalAlignment="Left" Margin="10,0,0,0" IsReadOnly="True" TextAlignment="Center"/>
        </Grid>

    </Grid>
</Window>