<Window x:Class="Semana06Prestamos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Semana06Prestamos"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="20,25,20,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Label Content="Cliente" HorizontalAlignment="Left" Margin="69,41,0,0" VerticalAlignment="Top"/>
        <Label Content="Fch.Ven:" HorizontalAlignment="Left" Margin="72,133,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="tbx_Cliente" HorizontalAlignment="Center" Margin="0,48,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <Label Grid.Column="1" Content="Monto a Pagar:" HorizontalAlignment="Left" Margin="10,41,0,0" VerticalAlignment="Top"/>
        <Label Grid.Column="1" Content="Fch.Pago:" HorizontalAlignment="Left" Margin="10,133,0,0" VerticalAlignment="Top"/>
        <Button x:Name="btn_Calcular" Content="Calcular" HorizontalAlignment="Left" Margin="102,5,0,0" Grid.Row="1" VerticalAlignment="Top" Click="btn_Calcular_Click"/>
        <Button x:Name="btn_Nuevo" Content="Nuevo" HorizontalAlignment="Left" Margin="363,5,0,0" Grid.Row="1" VerticalAlignment="Top" Grid.ColumnSpan="2" Click="btn_Nuevo_Click"/>
        <Button x:Name="btn_Finalizar" Grid.Column="1" Content="Finalizar" HorizontalAlignment="Left" Margin="200,5,0,0" Grid.Row="1" VerticalAlignment="Top" Click="btn_Finalizar_Click"/>
        <TextBox x:Name="tbx_MontoPago" Grid.Column="1" HorizontalAlignment="Left" Margin="110,47,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <DatePicker x:Name="dp_FechaVencimiento" HorizontalAlignment="Left" Margin="140,133,0,0" VerticalAlignment="Top"/>
        <DatePicker x:Name="dp_FechaPago" Grid.Column="1" HorizontalAlignment="Left" Margin="101,133,0,0" VerticalAlignment="Top"/>
        <Label Content="Dias de demora" HorizontalAlignment="Left" Margin="25,52,0,0" Grid.Row="1" VerticalAlignment="Top"/>
        <TextBox x:Name="tbx_DiasDemora" HorizontalAlignment="Left" Margin="155,57,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Background="#FFFFE875" IsEnabled="False"/>
        <Label Content="Demora en S/. :" HorizontalAlignment="Left" Margin="25,52,0,0" Grid.Row="1" VerticalAlignment="Top" Grid.Column="1"/>
        <TextBox x:Name="tbx_SolesDemora" Grid.Column="1" HorizontalAlignment="Left" Margin="162,57,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Background="#FFFFE875" IsEnabled="False"/>
        <Label Content="Demora %" HorizontalAlignment="Left" Margin="22,133,0,0" Grid.Row="1" VerticalAlignment="Top"/>
        <TextBox x:Name="tbx_DemoraPorcentual" HorizontalAlignment="Left" Margin="155,141,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Background="#FFFFE875" IsEnabled="False"/>
        <Label Content="Monto a pagar" HorizontalAlignment="Left" Margin="23,133,0,0" Grid.Row="1" VerticalAlignment="Top" Grid.Column="1"/>
        <TextBox x:Name="tbx_MontoaPagar" Grid.Column="1" HorizontalAlignment="Left" Margin="162,139,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Background="#FFFFE875" IsEnabled="False"/>

    </Grid>
</Window>
