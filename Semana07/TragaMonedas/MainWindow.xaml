<Window x:Class="TragaMonedas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TragaMonedas"
        mc:Ignorable="d"
        Title="Tragamonedas" Height="450" Width="800" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="68*"/>
            <RowDefinition Height="123*"/>
        </Grid.RowDefinitions>
        <Label x:Name="lblReloj" Content="00:00:00" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="36" FontWeight="Bold" Height="62" Width="157" Background="#FFEFFC97" Margin="0,10,0,10"/>
        <Button x:Name="btnInicio" Content="Iniciar Juego" HorizontalAlignment="Center" Grid.Row="1" VerticalAlignment="Center" FontWeight="Bold" FontSize="18" Margin="15,25,15,30" Padding="15,10,15,10" Click="Button_Click"/>
        <Grid Grid.Row="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="tbxJugada1" Grid.Column="1" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" Width="80" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="31" IsEnabled="False"/>
                <TextBox x:Name="tbxJugada3" Grid.Column="3" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" Width="80" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="30" IsEnabled="False"/>
                <TextBox x:Name="tbxJugada2" Grid.Column="2" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" Width="80" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="30" IsEnabled="False" />
            </Grid>
        </Grid>
        <Label x:Name="lblResultado" Content="" HorizontalAlignment="Center" Height="46" Grid.Row="3" VerticalAlignment="Center" Width="292" FontSize="24" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="#FF9AE7FC" Visibility="Hidden"/>

    </Grid>
</Window>
