<Window x:Class="SQLServerEjemplo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SQLServerEjemplo"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button x:Name="btnConectar" Content="Verificar Conectar" HorizontalAlignment="Left" Margin="48,53,0,0" VerticalAlignment="Top" Click="btnConectar_Click"/>
        <ComboBox x:Name="cbxCategorias" HorizontalAlignment="Left" Margin="223,57,0,0" VerticalAlignment="Top" Width="120" Text="cbxCategorias" DisplayMemberPath="Nombre" SelectedValuePath="Id"/>
        <Button x:Name="btnCargar" Content="CargarCategoria" HorizontalAlignment="Left" Margin="377,58,0,0" VerticalAlignment="Top" Click="btnCargar_Click"/>
        <Button x:Name="btnSeleccionado" Content="Seleccionado" HorizontalAlignment="Left" Margin="552,68,0,0" VerticalAlignment="Top" Click="btnSeleccionado_Click"/>
        <Button x:Name="btnMostrarProductos" Content="Producto" HorizontalAlignment="Left" Margin="686,68,0,0" VerticalAlignment="Top" Click="btnMostrarProductos_Click"/>
        <DataGrid x:Name="dgMostrarProductos" d:ItemsSource="{d:SampleData ItemCount=5}" Height="127" VerticalAlignment="Top" Margin="0,93,0,0"/>

    </Grid>
</Window>
