<Window x:Class="Ejercicio_Propuesto.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ejercicio_Propuesto"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid x:Name="cbImporte">
        <Label Content="INFORMACION GENERAL" HorizontalAlignment="Left" Margin="19,10,0,0" VerticalAlignment="Top" FontSize="20" Width="771" BorderBrush="Black" Background="#FFB13030"/>
        <Label Content="Personal:" HorizontalAlignment="Left" Margin="21,66,0,0" VerticalAlignment="Top" FontSize="18"/>
        <TextBox x:Name="txbPersonal" HorizontalAlignment="Left" Margin="124,74,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" FontSize="18"/>
        <Label Content="Codigo:" HorizontalAlignment="Left" Margin="366,66,0,0" VerticalAlignment="Top" FontSize="18"/>
        <TextBox x:Name="txbCodigo" HorizontalAlignment="Left" Margin="458,69,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" FontSize="18"/>
        <CheckBox x:Name="cbFonavi" Content="Fonavi(8%)" HorizontalAlignment="Left" Margin="31,156,0,0" VerticalAlignment="Top"/>
        <Label Content="Aportaciones" HorizontalAlignment="Left" Margin="27,114,0,0" VerticalAlignment="Top"/>
        <CheckBox x:Name="cbImporte1" Content="Imp.Renta(5%)" HorizontalAlignment="Left" Margin="31,188,0,0" VerticalAlignment="Top"/>
        <CheckBox x:Name="cbAFP" Content="A.F.P(12%)" HorizontalAlignment="Left" Margin="31,217,0,0" VerticalAlignment="Top"/>
        <Label Content="Resultados" HorizontalAlignment="Center" Margin="0,284,0,0" VerticalAlignment="Top" FontSize="16" Width="780" BorderBrush="Black" Background="#FFB13030"/>
        <Label x:Name="lbFonavi" Content="Fonavi:" HorizontalAlignment="Left" Margin="18,320,0,0" VerticalAlignment="Top"/>
        <Label x:Name="lbImporte" Content="Imp.renta :" HorizontalAlignment="Left" Margin="18,351,0,0" VerticalAlignment="Top"/>
        <Label x:Name="lbAFP" Content="A.F.P :" HorizontalAlignment="Left" Margin="21,382,0,0" VerticalAlignment="Top"/>
        <Label Content="Ingresos:" HorizontalAlignment="Left" Margin="18,246,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="tbxIngresos" HorizontalAlignment="Left" Margin="80,252,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <Button x:Name="btnCalcular" Content="calcular" HorizontalAlignment="Left" Margin="578,232,0,0" VerticalAlignment="Top" FontSize="18" Click="btnCalcular_Click"/>
        <Label x:Name="lbTotal" Content="Total a pagar:" HorizontalAlignment="Left" Margin="400,338,0,0" VerticalAlignment="Top" FontSize="24"/>

    </Grid>
</Window>
