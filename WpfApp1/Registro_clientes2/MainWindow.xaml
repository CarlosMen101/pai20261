<Window x:Class="Registro_clientes2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Registro_clientes2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="0,-2,0,2">
        <Label Content="Cliente:" HorizontalAlignment="Left" Margin="33,24,0,0" VerticalAlignment="Top" FontSize="14"/>
        <Label Content="Nro.cel:" HorizontalAlignment="Left" Margin="460,24,0,0" VerticalAlignment="Top" FontSize="14"/>
        <Label Content="Cantidad:" HorizontalAlignment="Left" Margin="33,78,0,0" VerticalAlignment="Top" FontSize="14"/>
        <Label Content="paginas" HorizontalAlignment="Left" Margin="280,81,0,0" VerticalAlignment="Top" FontSize="14"/>
        <TextBox x:Name="txtCantidad" HorizontalAlignment="Left" Margin="136,86,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="txtCliente" HorizontalAlignment="Left" Margin="136,32,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="txtCelular" HorizontalAlignment="Left" Margin="563,32,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <Label Content="Tarifa:" HorizontalAlignment="Left" Margin="39,135,0,0" VerticalAlignment="Top" FontSize="16"/>
        <RadioButton x:Name="rbEscolar" Content="Escolar" HorizontalAlignment="Left" Margin="143,144,0,0" VerticalAlignment="Top"/>
        <RadioButton x:Name="rbUniversitario" Content="Universitario" HorizontalAlignment="Left" Margin="280,144,0,0" VerticalAlignment="Top"/>
        <RadioButton x:Name="rbOrganizacion" Content="Organizacion" HorizontalAlignment="Left" Margin="400,145,0,0" VerticalAlignment="Top"/>
        <Button x:Name="btnEstadistica" Content="Estadistica" HorizontalAlignment="Left" Margin="677,143,0,0" VerticalAlignment="Top" FontSize="16"/>
        <Label Content="Cliente" HorizontalAlignment="Left" Margin="35,188,0,0" VerticalAlignment="Top" FontSize="18"/>
        <Label Content="Nro.CEL.:" HorizontalAlignment="Left" Margin="207,188,0,0" VerticalAlignment="Top" FontSize="18"/>
        <Label Content="Cantidad" HorizontalAlignment="Left" Margin="355,188,0,0" VerticalAlignment="Top" FontSize="18"/>
        <Label Content="Tarifa" HorizontalAlignment="Left" Margin="527,188,0,0" VerticalAlignment="Top" FontSize="18"/>
        <Label Content="Importe" HorizontalAlignment="Left" Margin="677,188,0,0" VerticalAlignment="Top" FontSize="18"/>
        <ListBox x:Name="lbxCliente" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="10,227,655,96"/>
        <ListBox x:Name="lbxCel" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="179,224,484,96"/>
        <ListBox x:Name="lbxCantidad" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="332,227,332,92"/>
        <ListBox x:Name="lbxTarifa" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="486,227,177,91"/>
        <ListBox x:Name="lbxImporte" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="652,226,10,91"/>
        <Label Content="Nro.Impresiones.escolares" HorizontalAlignment="Left" Margin="22,360,0,0" VerticalAlignment="Top" FontSize="14"/>
        <Label Content="Nro.Impresiones.Universitarias" HorizontalAlignment="Left" Margin="22,384,0,0" VerticalAlignment="Top" FontSize="14"/>
        <Label Content="Nro.Impresiones.Organizacionales" HorizontalAlignment="Left" Margin="416,364,0,0" VerticalAlignment="Top" FontSize="14"/>
        <TextBox x:Name="tbxNroEscolares" HorizontalAlignment="Left" Margin="217,366,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="tbxNroOrganizaciones" HorizontalAlignment="Left" Margin="657,373,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="tbxNroUniversitario" HorizontalAlignment="Left" Margin="220,392,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
    </Grid>
</Window>
