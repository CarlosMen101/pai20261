        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Estructuras_de_repeticion"
        mc:Ignorable="d"
        Title="ListBox" Height="450" Width="800">
    <Grid>
        <ListBox x:Name="lbxFrutas" SelectionChanged="ListBox_SelectionChanged" Margin="10,0,656,319">
            <ComboBoxItem Content="Piña"/>
        </ListBox>
        <Button x:Name="btnMostrar" Content="Mostrar" HorizontalAlignment="Left" Margin="10,127,0,0" VerticalAlignment="Top" Width="134" Click="btnMostrar_Click"/>
