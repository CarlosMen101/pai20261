        <TextBox x:Name="tbxAgregarFru" HorizontalAlignment="Left" Margin="17,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" Width="120"/>
        <Button x:Name="btnAgregar" Content="Agregar" HorizontalAlignment="Left" Margin="53,251,0,0" VerticalAlignment="Top" Click="btnAgregar_Click"/>

    </Grid>
</Window>
