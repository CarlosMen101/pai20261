<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Rectangle HorizontalAlignment="Left" Height="109" Margin="45,82,0,0" Stroke="Black" VerticalAlignment="Top" Width="383"/>
        <Label x:Name="lbCheckBox" Content="Uso de control de CheckBox" HorizontalAlignment="Left" Margin="248,143,0,0" VerticalAlignment="Top" Width="163" BorderBrush="Black" BorderThickness="1,1,1,1" HorizontalContentAlignment="Center"/>

        <Label Content="Control Checkbox" HorizontalAlignment="Left" Margin="55,47,0,0" VerticalAlignment="Top"/>
        <CheckBox x:Name="cbTipoLetra" Content="Tipo de letra" HorizontalAlignment="Left" Margin="55,100,0,0" VerticalAlignment="Top"/>
        <CheckBox x:Name="cbColorTexto" Content="Cambiar color de texto" HorizontalAlignment="Left" Margin="55,128,0,0" VerticalAlignment="Top"/>
        <CheckBox x:Name="cbColorFondo" Content="Cambiar color de fondo" HorizontalAlignment="Left" Margin="55,156,0,0" VerticalAlignment="Top"/>
        <Button x:Name="btnAplicar" Content="Aplicar" HorizontalAlignment="Left" Margin="309,102,0,0" VerticalAlignment="Top" Click="btnAplicar_Click"/>
        <Rectangle HorizontalAlignment="Left" Height="109" Margin="45,250,0,0" Stroke="Black" VerticalAlignment="Top" Width="383"/>
        <Label Content="Control RadioButton" HorizontalAlignment="Left" Margin="46,211,0,0" VerticalAlignment="Top"/>
        <RadioButton x:Name="rbTipoLetra" Content="Tipo de letra" HorizontalAlignment="Left" Margin="63,273,0,0" VerticalAlignment="Top"/>
        <RadioButton x:Name="rbColorTexto" Content="Cambiar color de fondo" HorizontalAlignment="Left" Margin="63,293,0,0" VerticalAlignment="Top"/>
        <RadioButton x:Name="rbColorFondo" Content="Cambiar color de fondo" HorizontalAlignment="Left" Margin="63,313,0,0" VerticalAlignment="Top"/>
        <Button x:Name="btnApliRadio" Content="Aplicar" HorizontalAlignment="Left" Margin="309,273,0,0" VerticalAlignment="Top" Click="btnApliRadio_Click"/>
        <Label x:Name="lbCheckB_Radio" Content="Uso de control de CheckBox" HorizontalAlignment="Left" Margin="248,309,0,0" VerticalAlignment="Top" Width="163" BorderBrush="Black" BorderThickness="1,1,1,1" HorizontalContentAlignment="Center"/>

    </Grid>
</Window>
