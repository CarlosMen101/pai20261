<Window x:Class="_4Notas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_4Notas"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid HorizontalAlignment="Left" Width="798">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Label Content="Promedio Notas" HorizontalAlignment="Left" Margin="308,10,0,0" VerticalAlignment="Top" FontSize="24" Grid.ColumnSpan="2"/>
        <Label Content="Nota1" HorizontalAlignment="Left" Margin="45,68,0,0" VerticalAlignment="Top" FontSize="22"/>
        <Label Content="Nota2" HorizontalAlignment="Left" Margin="45,136,0,0" VerticalAlignment="Top" FontSize="22"/>
        <Label Content="Nota3" HorizontalAlignment="Left" Margin="45,46,0,0" VerticalAlignment="Top" Grid.Row="1" FontSize="22"/>
        <Label Content="Nota4" HorizontalAlignment="Left" Margin="45,109,0,0" VerticalAlignment="Top" Grid.Row="1" FontSize="22"/>
        <TextBox x:Name="tbxNota1" HorizontalAlignment="Center" Margin="0,76,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" FontSize="16"/>
        <TextBox x:Name="tbxNota2" HorizontalAlignment="Center" Margin="0,148,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" FontSize="18"/>
        <TextBox x:Name="tbxNota3" HorizontalAlignment="Center" Margin="0,53,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" FontSize="18"/>
        <TextBox x:Name="tbxNota4" HorizontalAlignment="Center" Margin="0,116,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" FontSize="18"/>
        <Button x:Name="btnCalcular" Grid.Column="1" Content="Calcular" HorizontalAlignment="Center" Margin="0,148,0,0" VerticalAlignment="Top" FontSize="24" Height="62" Click="btnCalcular_Click"/>
        <TextBox x:Name="tbxResultado" Grid.Column="1" HorizontalAlignment="Center" Margin="0,83,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" FontSize="18" />
        <Label x:Name="lblResultado" Grid.Column="1" Content="" HorizontalAlignment="Center" Margin="0,120,0,0" Grid.Row="1" VerticalAlignment="Top" FontSize="22"/>

    </Grid>
</Window>
