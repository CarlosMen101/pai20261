<Window x:Class="radiobuttonycheckbox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:radiobuttonycheckbox"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Rectangle Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="141" Margin="41,60,0,0" Stroke="Black" VerticalAlignment="Top" Width="687" Grid.Row="1"/>

        <Rectangle Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="141" Margin="41,49,0,0" Stroke="Black" VerticalAlignment="Top" Width="687"/>
        <Label Content="Control Checkbox" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" FontSize="18"/>
        <Label Content="Control radiobutton" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" FontSize="18" Grid.Row="1"/>
        <CheckBox x:Name="cbxCambiarTipo" Content="Cambiar tipo de letra" HorizontalAlignment="Left" Margin="86,89,0,0" VerticalAlignment="Top"/>
        <CheckBox x:Name="cbxColorfondo" Content="Cambiar color de fondo" HorizontalAlignment="Left" Margin="86,157,0,0" VerticalAlignment="Top"/>
        <CheckBox x:Name="cbxColorLetra" Content="Cambiar color de letra" HorizontalAlignment="Left" Margin="86,124,0,0" VerticalAlignment="Top"/>
        <RadioButton x:Name="rbCambiarTipo" Content="Cambiar tipo de letra" HorizontalAlignment="Left" Margin="86,89,0,0" Grid.Row="1" VerticalAlignment="Top"/>
        <RadioButton x:Name="rbColorLetra" Content="Cambiar color de letra" HorizontalAlignment="Left" Margin="88,125,0,0" Grid.Row="1" VerticalAlignment="Top"/>
        <RadioButton x:Name="rbColorfondo" Content="Cambiar color de fondo" HorizontalAlignment="Left" Margin="86,161,0,0" Grid.Row="1" VerticalAlignment="Top"/>
        <Button x:Name="btnApliCheck" Grid.Column="1" Content="Aplicar" HorizontalAlignment="Left" Margin="122,67,0,0" VerticalAlignment="Top" FontSize="24" Click="btnApliCheck_Click"/>
        <Button x:Name="btnApliRadio" Grid.Column="1" Content="Aplicar" HorizontalAlignment="Left" Margin="122,75,0,0" Grid.Row="1" VerticalAlignment="Top" FontSize="24" Click="btnApliRadio_Click"/>
        <TextBox x:Name="tbxCheckbox" HorizontalAlignment="Left" Margin="30,139,0,0" TextWrapping="Wrap" Text="Uso de control CheckBox " VerticalAlignment="Top" Width="280" FontSize="24" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Column="1"/>
        <TextBox x:Name="tbxRadio" HorizontalAlignment="Left" Margin="396,142,0,0" Grid.Row="1" TextWrapping="Wrap" Text="Uso de control RadioButton" VerticalAlignment="Top" Width="332" HorizontalContentAlignment="Center" FontSize="24" Grid.ColumnSpan="2"/>

    </Grid>
</Window>
