<Window x:Class="Practica_pal_examen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Practica_pal_examen"
        mc:Ignorable="d"
        Title="Calculadora Responsiva" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="1.5*"/>
        </Grid.RowDefinitions>

        <Label Content="Calculadora Matemática" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" 
               HorizontalAlignment="Center" Margin="0,15,0,15" FontSize="26" FontWeight="Bold"/>

        <Label Content="Número 1:" Grid.Row="1" Grid.Column="0" 
               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0" FontSize="16"/>
        <TextBox x:Name="tbxNumero1" Grid.Row="1" Grid.Column="1" 
                 VerticalAlignment="Center" Height="36" FontSize="16" VerticalContentAlignment="Center"/>

        <Label Content="Número 2:" Grid.Row="2" Grid.Column="0" 
               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0" FontSize="16"/>
        <TextBox x:Name="tbxNumero2" Grid.Row="2" Grid.Column="1" 
                 VerticalAlignment="Center" Height="36" FontSize="16" VerticalContentAlignment="Center"/>

        <Label Content="Operaciones:" Grid.Row="1" Grid.Column="2" 
               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0" FontSize="18" FontWeight="SemiBold"/>

        <StackPanel Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" 
                    Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,25,0,0">
            <Button x:Name="btnSuma" Content="+" Width="55" Height="55" FontSize="26" Margin="6" Click="btnSuma_Click"/>
            <Button x:Name="btnResta" Content="-" Width="55" Height="55" FontSize="26" Margin="6" Click="btnResta_Click"/>
            <Button x:Name="btnMultiplicacion" Content="*" Width="55" Height="55" FontSize="26" Margin="6" Click="btnMultiplicacion_Click"/>
            <Button x:Name="btnDivision" Content="/" Width="55" Height="55" FontSize="26" Margin="6" Click="btnDivision_Click"/>
        </StackPanel>

        <Label Content="Resultado:" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" 
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Foreground="White" FontSize="24" Padding="20,15,0,0">
            <Label.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF1E1E1E" Offset="0"/>
                    <GradientStop Color="#FFE21F1F" Offset="1"/>
                </LinearGradientBrush>
            </Label.Background>
        </Label>

        <TextBox x:Name="tbxResultado" Grid.Row="3" Grid.Column="1" IsReadOnly="True"
                 VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="40" 
                 FontSize="20" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
    </Grid>
</Window>