<Window x:Class="Conecta4App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Juego 4 en Raya" Height="700" Width="750" MinHeight="550" MinWidth="600"
        WindowStartupLocation="CenterScreen" Background="#1A252F">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <!-- Fila 0: Header con Turno Actual -->
            <RowDefinition Height="Auto" />
            <!-- Fila 1: Tablero Responsivo con Viewbox -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Panel Superior: Indicador del Turno -->
        <Border Grid.Row="0" Background="#2C3E50" CornerRadius="10" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="indicadorColorTurno" Width="20" Height="20" Fill="Red" Margin="0,0,10,0"/>
                    <TextBlock x:Name="lblTurnoActual" Text="Turno de: Jugador 1" 
                               Foreground="White" FontSize="18" FontWeight="Bold"/>
                </StackPanel>

                <Button x:Name="btnCambiarModo" Grid.Column="1" Content="⚙ Cambiar Modo" 
                        Click="btnCambiarModo_Click" Padding="10,5" Background="#34495E" 
                        Foreground="White" FontWeight="Bold" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Tablero Dinámico (Uso de Viewbox para conservar proporciones al cambiar de tamaño) -->
        <Viewbox Grid.Row="1" Stretch="Uniform">
            <Grid x:Name="gridTableroContenedor" Width="700" Height="600" Background="#2980B9">

                <!-- Capa 1: Celdas del Tablero (6 Filas x 7 Columnas) -->
                <Grid x:Name="gridTableroVisual">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                </Grid>

                <!-- Capa 2: Overlays para resaltar Columnas (Hover e Interacción por Clic) -->
                <UniformGrid x:Name="gridColumnasInteractivas" Columns="7" Background="Transparent">
                    <!-- Las 7 columnas transparentes con eventos Hover se agregan desde C# -->
                </UniformGrid>

            </Grid>
        </Viewbox>
    </Grid>
</Window>