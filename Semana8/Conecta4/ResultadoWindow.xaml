<Window x:Class="Conecta4App.ResultadoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fin de la Partida" Height="240" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#2C3E50">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Icono / Mensaje Ganador -->
        <TextBlock x:Name="lblMensajeResultado" Text="🏆 ¡Ganó el Jugador 1!" 
                   Foreground="#F1C40F" FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>

        <TextBlock Grid.Row="1" Text="¿Deseas jugar una nueva partida?" 
                   Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Botones de Acción -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnJugarOtraVez" Grid.Column="0" Content="🔄 Jugar otra vez" 
                    Height="40" Background="#27AE60" Foreground="White" FontWeight="Bold" 
                    Cursor="Hand" Click="btnJugarOtraVez_Click"/>

            <Button x:Name="btnCerrar" Grid.Column="2" Content="❌ Cerrar" 
                    Height="40" Background="#E74C3C" Foreground="White" FontWeight="Bold" 
                    Cursor="Hand" Click="btnCerrar_Click"/>
        </Grid>
    </Grid>
</Window>