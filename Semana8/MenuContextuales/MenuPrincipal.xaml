<Window x:Class="MenuContextuales.MenuPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MenuContextuales"
        mc:Ignorable="d"
        Title="MenuPrincipal" Height="450" Width="800">
    <Grid>
        <DockPanel LastChildFill="False">
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="Archivo">
                    <MenuItem Header="Nuevo" Click="MenuItem_Click"/>
                    <MenuItem Header="Abrir"/>
                    <MenuItem Header="Guardar"/>
                    <Separator/>
                    <MenuItem Header="Salir" />
                </MenuItem>
                <MenuItem Header="Herramientas">
                    <MenuItem Header="Administrar usuarios"/>
                    <MenuItem Header="Mostrar usuarios" IsChecked="True" />

                </MenuItem>

            </Menu>
            <ToolBarTray DockPanel.Dock="Top">
                <ToolBar>
                    <Button Content="Nuevo"/>
                    <Button Content="Abrir"/>
                    <Button Content="Copiar"/>

                </ToolBar>
                <ToolBar>
                    <Button Content="Nuevo"/>
                    <Button Content="Abrir"/>
                    <Button Content="Copiar"/>

                </ToolBar>
            </ToolBarTray>
        </DockPanel>
    </Grid>
</Window>
