<Window x:Class="MenuContextuales.MenuPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:MenuContextuales"
        mc:Ignorable="d"
        Title="MenuPrincipal" Height="450" Width="800">
    <Grid>
        <DockPanel LastChildFill="True">
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="Archivo">
                    <MenuItem Header="Nuevo" Click="MenuItem_Click"/>
                    <MenuItem Header="Abrir"/>
                    <MenuItem Header="Guardar"/>
                    <Separator/>
                    <MenuItem Header="Salir" />
                </MenuItem>
                <MenuItem Header="Herramientas">
                    <MenuItem Header="Administrar usuarios"/>
                    <MenuItem Header="Mostrar usuarios" IsCheckable="True" IsChecked="True" />
                </MenuItem>
            </Menu>

            <ToolBarTray DockPanel.Dock="Top">
                <ToolBar>
                    <Button Content="Nuevo"/>
                    <Button Content="Abrir"/>
                    <Button Content="Guardar"/>
                </ToolBar>
                <ToolBar>
                    <Button Command="Cut" >
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/iconos/icons8-cut-48.png" Width="18" />
                            <Label Content="Cortar"/>
                        </StackPanel>
                    </Button>
                    <Button Command="Copy">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/iconos/icons8-copy-50.png" Width="19" />
                            <Label Content="Copiar"/>
                        </StackPanel>
                    </Button>
                    <Button Command="Paste" Content="Pegar"/>
                </ToolBar>
            </ToolBarTray>
            <TextBox TextWrapping="Wrap" Text="TextBox" Width="476" Height="124"/>
        </DockPanel>
    </Grid>
</Window>